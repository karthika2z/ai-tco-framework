{
  "name": "droidwork-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev":    "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute droidwork-leads --file=schema.sql",
    "db:init:remote": "wrangler d1 execute droidwork-leads --remote --file=schema.sql",
    "leads":  "wrangler d1 execute droidwork-leads --remote --command='SELECT * FROM leads ORDER BY created_at DESC LIMIT 50'"
  },
  "devDependencies": {
    "wrangler": "^3.0.0"
  }
}
